parking = []
while True:
    print("\n1. Car Entry (Enqueue)")
    print("2. Car Exit (Dequeue)")
    print("3. Display Cars")
    print("4. Exit")

    choice = int(input("Enter your choice: "))

    if choice == 1:
        car = input("Enter car number: ")
        parking.append(car)
        print("Car parked:", car)

    elif choice == 2:
        if len(parking) == 0:
            print("Parking is empty")
        else:
            car = parking.pop(0)
            print("Car exited:", car)

    elif choice == 3:
        if len(parking) == 0:
            print("Parking is empty")
        else:
            print("Parked cars:")
            for car in parking:
                print(car)
    elif choice == 4:
        print("Exit")
        break

    else:
        print("Invalid choice")

