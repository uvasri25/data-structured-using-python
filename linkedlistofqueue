class Cars:
    def __init__(self,car):
        self.data=car
        self.next=None

class Parking:
    def __init__(self):
        self.front=None
        self.rear=None
   
    def is_empty(self):
        return self.front is None
   
    def enqueue(self,car):
        new_node=Cars(car)
        if self.front is None:
            self.front=self.rear=new_node
            return
        self.rear.next=new_node
        self.rear=new_node
    def dequeue(self):
        if self.is_empty():
            return None
        data=self.front.data
        if self.front is None:
            self.rear=None
        return
    def peek(self):
        if self.is_empty():
            return None
        return self.front.data
    def size(self):
        count=0
        current=self.front
        while current:
            count+=1
            current=current.next
        return count
    def display(self):
        if self.is_empty():
            print("Parking is empty.")
            return
        print("\n Parking Space:")
        current=self.front
        while current is not None:
            print(f"[{current.data}]->",end="")
            current=current.next
        print("NULL \n")
