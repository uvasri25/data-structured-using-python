class Book:
    def __init__(self, data):
        self.data = data
        self.left = None
        self.right = None


def inorder(root):
    if root:
        inorder(root.left)
        print(root.data, end=" ")
        inorder(root.right)


def preorder(root):
    if root:
        print(root.data, end=" ")
        preorder(root.left)
        preorder(root.right)


def postorder(root):
    if root:
        postorder(root.left)
        postorder(root.right)
        print(root.data, end=" ")


# Creating the tree
root = Book("Harry Potter")
root.left = Book("Java")
root.right = Book("The Lord of Rings")
root.left.left = Book("The Hobbit")
root.left.right = Book("Ponniyin Selvan")

while True:
    print("\n1. Preorder")
    print("2. Inorder")
    print("3. Postorder")
    print("4. Exit")

    ch = input("Enter your choice: ")

    if ch == '1':
        print("Preorder:", end=" ")
        preorder(root)

    elif ch == '2':
        print("Inorder:", end=" ")
        inorder(root)

    elif ch == '3':
        print("Postorder:", end=" ")
        postorder(root)

    elif ch == '4':
        print("Exiting the program")
        break

    else:
        print("Invalid input")
